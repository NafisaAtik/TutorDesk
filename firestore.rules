rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Shared Hardened Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validation Helpers ---
    function isValidBatch(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.hscLevel is string && data.hscLevel in ['XI', 'XII', 'HSC Revision'] &&
             data.scheduleDays is string && data.scheduleDays.size() >= 1 && data.scheduleDays.size() <= 60 &&
             data.scheduleTime is string && data.scheduleTime.size() >= 1 && data.scheduleTime.size() <= 30 &&
             data.room is string && data.room.size() <= 60 &&
             data.currentTopic is string && data.currentTopic.size() <= 120 &&
             data.monthlyFeeBdt is int && data.monthlyFeeBdt >= 0 && data.monthlyFeeBdt <= 100000 &&
             data.maxCapacity is int && data.maxCapacity >= 1 && data.maxCapacity <= 500 &&
             data.status is string && data.status in ['ACTIVE', 'ARCHIVED'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStudent(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidId(data.batchId) &&
             data.batchName is string && data.batchName.size() >= 1 && data.batchName.size() <= 80 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.college is string && data.college.size() <= 100 &&
             data.rollNumber is string && data.rollNumber.size() <= 30 &&
             data.guardianPhone is string && data.guardianPhone.size() <= 25 &&
             data.monthlyFeeBdt is int && data.monthlyFeeBdt >= 0 && data.monthlyFeeBdt <= 100000 &&
             data.status is string && data.status in ['ACTIVE', 'PAUSED'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAttendanceRecord(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidId(data.batchId) &&
             isValidId(data.studentId) &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 80 &&
             data.dateIso is string && data.dateIso.size() == 10 && data.dateIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.status is string && data.status in ['PRESENT', 'LATE', 'ABSENT'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFeePayment(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidId(data.studentId) &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 80 &&
             isValidId(data.batchId) &&
             data.batchName is string && data.batchName.size() >= 1 && data.batchName.size() <= 80 &&
             data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$') &&
             data.expectedFeeBdt is int && data.expectedFeeBdt >= 0 && data.expectedFeeBdt <= 100000 &&
             data.paidAmountBdt is int && data.paidAmountBdt >= 0 && data.paidAmountBdt <= 100000 &&
             data.paymentMethod is string && data.paymentMethod in ['Cash', 'bKash', 'Nagad', 'Rocket', 'Bank'] &&
             data.note is string && data.note.size() <= 200 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- User-Scoped Collections ---
    match /users/{userId} {
      allow read, write: if false;

      match /batches/{batchId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(batchId);
        allow create: if isOwner(userId) &&
                         isValidId(batchId) &&
                         incoming().keys().hasAll(['userId', 'name', 'hscLevel', 'scheduleDays', 'scheduleTime', 'room', 'currentTopic', 'monthlyFeeBdt', 'maxCapacity', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'hscLevel', 'scheduleDays', 'scheduleTime', 'room', 'currentTopic', 'monthlyFeeBdt', 'maxCapacity', 'status', 'createdAt', 'updatedAt']) &&
                         isValidBatch(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(batchId) &&
                         isValidBatch(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'hscLevel', 'scheduleDays', 'scheduleTime', 'room', 'currentTopic', 'monthlyFeeBdt', 'maxCapacity', 'status', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(batchId);
      }

      match /students/{studentId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(studentId);
        allow create: if isOwner(userId) &&
                         isValidId(studentId) &&
                         incoming().keys().hasAll(['userId', 'batchId', 'batchName', 'name', 'college', 'rollNumber', 'guardianPhone', 'monthlyFeeBdt', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'batchId', 'batchName', 'name', 'college', 'rollNumber', 'guardianPhone', 'monthlyFeeBdt', 'status', 'createdAt', 'updatedAt']) &&
                         isValidStudent(incoming(), userId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/batches/$(incoming().batchId));
        allow update: if isOwner(userId) &&
                         isValidId(studentId) &&
                         isValidStudent(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         exists(/databases/$(database)/documents/users/$(userId)/batches/$(incoming().batchId)) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['batchId', 'batchName', 'name', 'college', 'rollNumber', 'guardianPhone', 'monthlyFeeBdt', 'status', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(studentId);
      }

      match /attendance/{recordId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(recordId);
        allow create: if isOwner(userId) &&
                         isValidId(recordId) &&
                         incoming().keys().hasAll(['userId', 'batchId', 'studentId', 'studentName', 'dateIso', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'batchId', 'studentId', 'studentName', 'dateIso', 'status', 'createdAt', 'updatedAt']) &&
                         isValidAttendanceRecord(incoming(), userId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/batches/$(incoming().batchId)) &&
                         exists(/databases/$(database)/documents/users/$(userId)/students/$(incoming().studentId));
        allow update: if isOwner(userId) &&
                         isValidId(recordId) &&
                         isValidAttendanceRecord(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().batchId == existing().batchId &&
                         incoming().studentId == existing().studentId &&
                         incoming().dateIso == existing().dateIso &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['studentName', 'status', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(recordId);
      }

      match /feePayments/{paymentId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(paymentId);
        allow create: if isOwner(userId) &&
                         isValidId(paymentId) &&
                         incoming().keys().hasAll(['userId', 'studentId', 'studentName', 'batchId', 'batchName', 'monthKey', 'expectedFeeBdt', 'paidAmountBdt', 'paymentMethod', 'note', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'studentId', 'studentName', 'batchId', 'batchName', 'monthKey', 'expectedFeeBdt', 'paidAmountBdt', 'paymentMethod', 'note', 'createdAt', 'updatedAt']) &&
                         isValidFeePayment(incoming(), userId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/batches/$(incoming().batchId)) &&
                         exists(/databases/$(database)/documents/users/$(userId)/students/$(incoming().studentId));
        allow update: if isOwner(userId) &&
                         isValidId(paymentId) &&
                         isValidFeePayment(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().studentId == existing().studentId &&
                         incoming().monthKey == existing().monthKey &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['studentName', 'batchId', 'batchName', 'expectedFeeBdt', 'paidAmountBdt', 'paymentMethod', 'note', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(paymentId);
      }
    }
  }
}
